<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?><?import javafx.scene.control.Button?><?import javafx.scene.control.ColorPicker?><?import javafx.scene.control.ListView?><?import javafx.scene.control.TextField?><?import javafx.scene.layout.HBox?><?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="10" xmlns="http://javafx.com/javafx/24.0.1">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <ListView fx:id="labels" VBox.vgrow="ALWAYS" />

    <HBox spacing="10">
        <TextField fx:id="newLabelTitle" HBox.hgrow="ALWAYS" promptText="%editboard.labels.placeholder.new-title" />
        <ColorPicker fx:id="newLabelColor" />
        <Button fx:id="addLabelButton" text="%btn.add" />
    </HBox>
</VBox>
